LADLE_ENVIRONMENT=development
LADLE_JWT_SIGNING_SECRET=change-me-development-only
LADLE_DATA_ENCRYPTION_KEY=change-me-development-only
LADLE_DATABASE_URL=postgresql+psycopg://ladle:ladle@127.0.0.1:5432/ladle
LADLE_ACCESS_TOKEN_ISSUER=ladle
LADLE_ACCESS_TOKEN_MINUTES=15
LADLE_REFRESH_TOKEN_DAYS=30
LADLE_REFRESH_ROTATION_GRACE_SECONDS=5
LADLE_ATTESTATION_ENFORCED=false
LADLE_IMPORT_RESERVATION_MINUTES=60
LADLE_SOURCE_REDIRECT_TIMEOUT_SECONDS=10
LADLE_EXTRACTION_CLAIM_MINUTES=10
LADLE_PUBLIC_CACHE_RECHECK_DAYS=7
LADLE_CELERY_ENABLED=false
LADLE_CELERY_BROKER_URL=redis://127.0.0.1:6379/0
LADLE_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
LADLE_CELERY_VISIBILITY_TIMEOUT_SECONDS=3600
LADLE_WORKER_PROVIDER_MODE=disabled

LADLE_SUPADATA_BASE_URL=https://api.supadata.ai/v1
LADLE_SUPADATA_TIMEOUT_SECONDS=30
LADLE_SUPADATA_API_KEY=

