LADLE_ENVIRONMENT=development
LADLE_JWT_SIGNING_SECRET=change-me-development-only
LADLE_DATA_ENCRYPTION_KEY=change-me-development-only
LADLE_DATABASE_URL=postgresql+psycopg://ladle:ladle@127.0.0.1:5432/ladle
LADLE_ACCESS_TOKEN_ISSUER=ladle
LADLE_ACCESS_TOKEN_MINUTES=15
LADLE_REFRESH_TOKEN_DAYS=30
LADLE_REFRESH_ROTATION_GRACE_SECONDS=5
LADLE_ATTESTATION_ENFORCED=false
LADLE_IMPORT_RESERVATION_MINUTES=60
LADLE_SOURCE_REDIRECT_TIMEOUT_SECONDS=10
LADLE_EXTRACTION_CLAIM_MINUTES=10
LADLE_PUBLIC_CACHE_RECHECK_DAYS=7
LADLE_CELERY_ENABLED=false
LADLE_CELERY_BROKER_URL=redis://127.0.0.1:6379/0
LADLE_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
LADLE_CELERY_VISIBILITY_TIMEOUT_SECONDS=3600
LADLE_WORKER_PROVIDER_MODE=disabled
LADLE_PROVIDER_DAILY_BILLED_UNIT_LIMIT=1000
LADLE_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
LADLE_PROVIDER_CIRCUIT_COOLDOWN_SECONDS=300
LADLE_SERVER_MEDIA_FALLBACK_ENABLED=false
LADLE_OBJECT_STORAGE_ENABLED=false
LADLE_OBJECT_STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
LADLE_OBJECT_STORAGE_REGION=us-east-1
LADLE_OBJECT_STORAGE_BUCKET=ladle-private
LADLE_OBJECT_STORAGE_ACCESS_KEY=ladle-local
LADLE_OBJECT_STORAGE_SECRET_KEY=ladle-local-secret

LADLE_SUPADATA_BASE_URL=https://api.supadata.ai/v1
LADLE_SUPADATA_TIMEOUT_SECONDS=30
LADLE_SUPADATA_API_KEY=

LADLE_SOSCRIPTED_BASE_URL=https://soscripted.com/api/public
LADLE_SOSCRIPTED_TIMEOUT_SECONDS=30
LADLE_SOSCRIPTED_API_KEY=

# Extraction LLM — OpenRouter is the default provider. Set the key and
# flip LADLE_WORKER_PROVIDER_MODE=live to run real extractions.
LADLE_EXTRACTION_PROVIDER=openrouter
LADLE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LADLE_OPENROUTER_TIMEOUT_SECONDS=90
LADLE_OPENROUTER_API_KEY=
LADLE_OPENROUTER_MODEL_ID=moonshotai/kimi-k2.5
LADLE_OPENROUTER_MAX_TOKENS=8192

# Direct Anthropic API (alternative to OpenRouter; set
# LADLE_EXTRACTION_PROVIDER=anthropic to use it).
LADLE_ANTHROPIC_BASE_URL=https://api.anthropic.com
LADLE_ANTHROPIC_TIMEOUT_SECONDS=60
LADLE_ANTHROPIC_API_KEY=
LADLE_APPLE_ENABLED=false
LADLE_APPLE_BUNDLE_ID=com.ladle.app
LADLE_APPLE_TEAM_ID=
LADLE_APPLE_KEY_ID=
LADLE_APPLE_PRIVATE_KEY=
LADLE_ANTHROPIC_MODEL_ID=claude-sonnet-4-6
LADLE_ANTHROPIC_MAX_TOKENS=8192
