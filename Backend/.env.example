LADLE_ENVIRONMENT=development
LADLE_JWT_SIGNING_SECRET=change-me-development-only
# Production loads the JSON keyring from managed secret storage. New writes use
# the active ID; retain prior IDs until all matching LPT2 values have aged out.
LADLE_DATA_ENCRYPTION_KEY=change-me-development-only
LADLE_DATA_ENCRYPTION_ACTIVE_KEY_ID=
LADLE_DATA_ENCRYPTION_KEYRING=
LADLE_MAXIMUM_REQUEST_BODY_BYTES=1048576
LADLE_DATABASE_URL=postgresql+psycopg://ladle:ladle@127.0.0.1:5432/ladle
LADLE_ACCESS_TOKEN_ISSUER=ladle
LADLE_ACCESS_TOKEN_MINUTES=15
LADLE_REFRESH_TOKEN_DAYS=30
LADLE_REFRESH_ROTATION_GRACE_SECONDS=5
LADLE_ATTESTATION_ENFORCED=false
LADLE_APP_ATTEST_APP_ID_PREFIX=
LADLE_APP_ATTEST_BUNDLE_ID=com.ladle.ios
LADLE_APP_ATTEST_ENVIRONMENT=production
LADLE_APP_ATTEST_CHALLENGE_SECONDS=300
LADLE_RATE_LIMITING_ENABLED=false
LADLE_RATE_LIMIT_REDIS_URL=redis://redis:6379/2
# Configure only CIDRs belonging to the deployment ingress. Forwarded client
# addresses are ignored unless the immediate peer is trusted.
LADLE_RATE_LIMIT_TRUSTED_PROXY_CIDRS=
LADLE_DURABLE_METRICS_ENABLED=false
LADLE_METRICS_REDIS_URL=redis://redis:6379/3
LADLE_METRICS_KEY_PREFIX=ladle:metrics:v1
LADLE_METRICS_AUTH_TOKEN=
LADLE_STRUCTURED_LOGGING_ENABLED=true
LADLE_LOG_LEVEL=INFO
LADLE_TRACING_ENABLED=false
LADLE_TRACING_OTLP_ENDPOINT=
LADLE_TRACING_SERVICE_NAME=ladle
LADLE_IMPORT_RESERVATION_MINUTES=60
LADLE_USER_IMPORT_DAILY_QUOTA=20
LADLE_USER_IMPORT_MONTHLY_QUOTA=200
LADLE_SOURCE_REDIRECT_TIMEOUT_SECONDS=10
LADLE_EXTRACTION_CLAIM_MINUTES=10
LADLE_PUBLIC_CACHE_RECHECK_DAYS=7
LADLE_IMPORT_STALE_AFTER_MINUTES=32
LADLE_IMPORT_MAINTENANCE_INTERVAL_SECONDS=30
LADLE_RETENTION_MAINTENANCE_INTERVAL_SECONDS=3600
LADLE_RETENTION_EXPIRED_SESSION_DAYS=7
LADLE_RETENTION_TERMINAL_IMPORT_DAYS=30
LADLE_RETENTION_PRIVATE_TEXT_HOURS=24
LADLE_RETENTION_PROVIDER_ATTEMPT_DAYS=90
LADLE_RETENTION_SYNC_HISTORY_DAYS=365
LADLE_RETENTION_INVALID_CACHE_DAYS=30
LADLE_RETENTION_DELETION_AUDIT_DAYS=365
LADLE_OBJECT_DELETION_MAXIMUM_ATTEMPTS=8
LADLE_OBJECT_DELETION_BATCH_SIZE=100
LADLE_CELERY_ENABLED=false
LADLE_CELERY_BROKER_URL=redis://127.0.0.1:6379/0
LADLE_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
LADLE_CELERY_VISIBILITY_TIMEOUT_SECONDS=3600
LADLE_WORKER_PROVIDER_MODE=disabled
LADLE_PROVIDER_DAILY_BILLED_UNIT_LIMIT=1000
LADLE_PROVIDER_RESERVATION_BILLED_UNITS=3
LADLE_PROVIDER_BUDGET_RESERVATION_MINUTES=30
LADLE_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
LADLE_PROVIDER_CIRCUIT_COOLDOWN_SECONDS=300
LADLE_SERVER_MEDIA_FALLBACK_ENABLED=false
LADLE_OBJECT_STORAGE_ENABLED=false
LADLE_OBJECT_STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
LADLE_OBJECT_STORAGE_REGION=us-east-1
LADLE_OBJECT_STORAGE_BUCKET=ladle-private
LADLE_OBJECT_STORAGE_ACCESS_KEY=ladle-local
LADLE_OBJECT_STORAGE_SECRET_KEY=ladle-local-secret

# Keyless first rung: yt-dlp metadata and captions, plus recipe pages the
# creator pointed at. Runs before any billed provider; when it covers the
# recipe on its own, Supadata and SoScripted are never called.
LADLE_FREE_ACQUISITION_ENABLED=true
LADLE_FREE_ACQUISITION_SUBTITLES=true
LADLE_FREE_ACQUISITION_FOLLOW_LINKS=true
# Leave blank to discover yt-dlp beside the interpreter, then on PATH.
LADLE_YTDLP_BINARY_PATH=
# Optional Netscape-format browser cookies for private/local Instagram and
# TikTok acquisition. Treat this file as an account secret and never commit it.
LADLE_YTDLP_COOKIES_FILE=
LADLE_YTDLP_TIMEOUT_SECONDS=90
LADLE_LINKED_PAGE_TIMEOUT_SECONDS=12

# Whisper on the raw audio, using the OpenRouter key above. Runs only when
# every free rung came up short, and before the transcript providers, which
# it undercuts by roughly an order of magnitude.
LADLE_AUDIO_TRANSCRIPTION_ENABLED=true
LADLE_TRANSCRIPTION_MODEL_ID=openai/whisper-large-v3
LADLE_TRANSCRIPTION_TIMEOUT_SECONDS=300
LADLE_TRANSCRIPTION_MAX_AUDIO_BYTES=20971520
LADLE_TRANSCRIPTION_MAX_DURATION_SECONDS=1800

# Frames read by a vision model, for the silent videos where the method is
# only ever shown. Same model as extraction, and it runs before the paid
# visual provider it undercuts.
LADLE_FRAME_ANALYSIS_ENABLED=true
LADLE_FRAME_ANALYSIS_MODEL_ID=google/gemini-3.6-flash
LADLE_FRAME_ANALYSIS_MAX_FRAMES=8
LADLE_FRAME_ANALYSIS_TIMEOUT_SECONDS=120

LADLE_SUPADATA_BASE_URL=https://api.supadata.ai/v1
LADLE_SUPADATA_TIMEOUT_SECONDS=30
LADLE_SUPADATA_API_KEY=

LADLE_SOSCRIPTED_BASE_URL=https://soscripted.com/api/public
LADLE_SOSCRIPTED_TIMEOUT_SECONDS=600
LADLE_SOSCRIPTED_API_KEY=

# Extraction LLM — OpenRouter is the default provider. Set the key and
# flip LADLE_WORKER_PROVIDER_MODE=live to run real extractions.
LADLE_EXTRACTION_PROVIDER=openrouter
LADLE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LADLE_OPENROUTER_TIMEOUT_SECONDS=90
LADLE_OPENROUTER_API_KEY=
LADLE_OPENROUTER_MODEL_ID=google/gemini-3.6-flash
LADLE_OPENROUTER_MAX_TOKENS=32768

# Direct Anthropic API (alternative to OpenRouter; set
# LADLE_EXTRACTION_PROVIDER=anthropic to use it).
LADLE_ANTHROPIC_BASE_URL=https://api.anthropic.com
LADLE_ANTHROPIC_TIMEOUT_SECONDS=60
LADLE_ANTHROPIC_API_KEY=
LADLE_APPLE_ENABLED=false
LADLE_APPLE_BUNDLE_ID=com.ladle.ios
LADLE_APPLE_TEAM_ID=
LADLE_APPLE_KEY_ID=
LADLE_APPLE_PRIVATE_KEY=
LADLE_GOOGLE_ENABLED=false
LADLE_GOOGLE_SERVER_CLIENT_ID=
LADLE_ANTHROPIC_MODEL_ID=claude-sonnet-4-6
LADLE_ANTHROPIC_MAX_TOKENS=8192
