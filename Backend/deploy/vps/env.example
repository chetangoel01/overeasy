# Copy to /opt/ladle/.env, set mode 0600, and replace every change-me value.
LADLE_PUBLIC_HOSTNAME=api.example.com
LADLE_RATE_LIMIT_TRUSTED_PROXY_CIDRS=172.18.0.0/16
LADLE_ENVIRONMENT=production
LADLE_ATTESTATION_ENFORCED=true
LADLE_APP_ATTEST_ENVIRONMENT=production

# Generate independent values with: openssl rand -hex 32
LADLE_DATABASE_PASSWORD=change-me
LADLE_REDIS_PASSWORD=change-me
LADLE_JWT_SIGNING_SECRET=change-me
LADLE_DATA_ENCRYPTION_KEY=change-me
LADLE_METRICS_AUTH_TOKEN=change-me
LADLE_OBJECT_STORAGE_ACCESS_KEY=change-me
LADLE_OBJECT_STORAGE_SECRET_KEY=change-me

# Keep old encryption keys in the JSON keyring until matching encrypted values
# have expired. The active ID must name one entry in the keyring.
LADLE_DATA_ENCRYPTION_ACTIVE_KEY_ID=2026-q3
LADLE_DATA_ENCRYPTION_KEYRING={"2026-q3":"change-me"}

# Import providers. OpenRouter is the default extraction and transcription path.
LADLE_EXTRACTION_PROVIDER=openrouter
LADLE_OPENROUTER_API_KEY=change-me
LADLE_ANTHROPIC_API_KEY=
LADLE_SUPADATA_API_KEY=
LADLE_SOSCRIPTED_API_KEY=
LADLE_AUDIO_TRANSCRIPTION_ENABLED=true
LADLE_FRAME_ANALYSIS_ENABLED=false
LADLE_THUMBNAIL_ANALYSIS_ENABLED=true

# Apple App Attest and Sign in with Apple use the same registered App ID.
LADLE_APPLE_ENABLED=true
LADLE_APP_ATTEST_APP_ID_PREFIX=CHANGE12345
LADLE_APP_ATTEST_BUNDLE_ID=com.ladle.ios
LADLE_APPLE_BUNDLE_ID=com.ladle.ios
LADLE_APPLE_TEAM_ID=CHANGE12345
LADLE_APPLE_KEY_ID=CHANGEKEY1
LADLE_APPLE_PRIVATE_KEY_PATH=/opt/ladle/secrets/AuthKey_CHANGEKEY1.p8

# The web/server OAuth client ID, not the iOS client ID.
LADLE_GOOGLE_ENABLED=true
LADLE_GOOGLE_SERVER_CLIENT_ID=change-me.apps.googleusercontent.com
