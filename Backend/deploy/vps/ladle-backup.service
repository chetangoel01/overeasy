[Unit]
Description=Create and validate a Ladle PostgreSQL backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/ladle-operations backup
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/ladle /var/lib/ladle/locks/deploy.lock /var/lib/ladle/locks/transition.lock /var/lib/ladle/operations /var/log/ladle
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
