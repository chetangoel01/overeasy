{
  "postgresql": {
    "minimumMajorVersion": 16,
    "automatedBackups": true,
    "backupRetentionDays": 35,
    "pointInTimeRecovery": true,
    "pitrWindowDays": 7,
    "encrypted": true,
    "multiAvailabilityZone": true,
    "crossRegionBackup": true,
    "restoreDrillMaximumAgeDays": 90,
    "recoveryPointObjectiveMinutes": 5,
    "recoveryTimeObjectiveMinutes": 60
  },
  "redis": {
    "minimumMajorVersion": 7,
    "appendOnly": true,
    "appendFsync": "everysec",
    "snapshotIntervalMinutes": 60,
    "maxmemoryPolicy": "noeviction",
    "multiAvailabilityZone": true,
    "automaticFailover": true,
    "persistenceRequiredBeforeWrites": true,
    "recoveryBehavior": "outbox-redispatch"
  }
}
